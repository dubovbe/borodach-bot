{
  "name": "borodach-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:worker && npm run test:probe",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "test:probe": "node --test tests/node/*.test.ts",
    "test:worker": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "ops:backup": "node scripts/backup-ops.ts backup",
    "ops:restore": "node scripts/backup-ops.ts restore",
    "ops:status": "node scripts/backup-ops.ts status",
    "test:recovery": "node scripts/recovery-check.ts",
    "probe:neon": "node --env-file=.env scripts/probe-neon.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "grammy": "1.46.0",
    "libphonenumber-js": "1.13.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
